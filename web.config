<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="routes" /><add segment="docs" /><add segment="app" /><add segment="config" /><add segment="includes" /><add segment="tests" />
          <add segment="tools" /><add segment="storage" /><add segment="database" /><add segment="vendor" />
          <add segment=".git" /><add segment=".env" /><add segment=".idea" /><add segment=".codex" /><add segment=".agents" /><add segment=".aws" />
          <add segment="composer.json" /><add segment="composer.lock" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="Deny direct public access" stopProcessing="true"><match url="^public(?:/|$)" ignoreCase="true" /><conditions><add input="{REQUEST_URI}" pattern="/public(?:/|$|\?)" ignoreCase="true" /></conditions><action type="CustomResponse" statusCode="404" statusReason="Not found" statusDescription="Not found" /></rule>
        <rule name="Public assets" stopProcessing="true"><match url="^(assets/.+\.(?:css|js|json|png|jpe?g|svg|ttf|woff2?|txt)|manifest\.php|sw\.js|offline\.html)$" ignoreCase="true" /><action type="Rewrite" url="public/{R:1}" appendQueryString="true" /></rule>
        <rule name="Front controller" stopProcessing="true"><match url="^(?!index\.php$|public/).*" /><action type="Rewrite" url="index.php" appendQueryString="true" /></rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
