<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="routes" /><add segment="docs" /><add segment="app" /><add segment="config" /><add segment="includes" /><add segment="tests" />
          <add segment="tools" /><add segment="storage" /><add segment="database" />
          <add segment=".git" /><add segment=".env" />
          <add segment="composer.json" /><add segment="composer.lock" />
          <add segment="check_schema.php" /><add segment="find_closed_bills.php" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
  <location path="vendor">
    <system.webServer>
      <security>
        <authorization><clear /><deny users="*" /></authorization>
      </security>
    </system.webServer>
  </location>
</configuration>
